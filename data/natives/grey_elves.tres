requests = Array[ExtResource("2_request")]([SubResource("RootsRequest"), SubResource("ShrineRequest")])
request_action = &"fulfill_elves_request"
request_key_label = "H"
legitimacy_per_raider_slain = 0
legitimacy_per_raider_fled = 5
legitimacy_per_guardian_fallen = 0
oath_threshold = 61
oath_population_bonus = 4
discovered_text = "Elfos Cinzentos encontrados"
requests_done_text = "Todos os pedidos dos Elfos foram cumpridos"
oath_effect_text = "as galerias das Raízes abrigam +4 de população"

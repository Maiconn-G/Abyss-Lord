[gd_resource type="Resource" script_class="NativePeopleDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://core/definitions/native_people_definition.gd" id="1_people"]
[ext_resource type="Script" path="res://core/definitions/native_request_definition.gd" id="2_request"]
[ext_resource type="Script" path="res://core/definitions/construction_definition.gd" id="3_construction"]
[ext_resource type="Script" path="res://core/definitions/soldier_definition.gd" id="4_soldier"]
[ext_resource type="Resource" path="res://data/resources/iron_ore.tres" id="5_iron_ore"]
[ext_resource type="Resource" path="res://data/resources/biomass.tres" id="6_biomass"]

[sub_resource type="Resource" id="AncientSeal"]
script = ExtResource("3_construction")
build_cost = 0
work_required = 10.0

[sub_resource type="Resource" id="ArmorRequest"]
script = ExtResource("2_request")
request_id = &"armor_steel"
display_name = "Aço para as armaduras"
resource = ExtResource("5_iron_ore")

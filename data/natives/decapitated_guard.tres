legitimacy_gain = 20

[sub_resource type="Resource" id="VigilRequest"]
script = ExtResource("2_request")
request_id = &"vigil_sustenance"
display_name = "Sustento da vigília"
resource = ExtResource("6_biomass")
amount = 5
legitimacy_gain = 20

[sub_resource type="Resource" id="Guardian"]
script = ExtResource("4_soldier")
unit_type_id = &"decapitated_guardian"
display_name = "Guardião Decapitado"
max_health = 140.0
move_speed = 3.5
recruit_essence_cost = 0.0
attack_damage = 16.0
attack_range = 1.5
attack_interval = 0.9

[resource]
script = ExtResource("1_people")
people_id = &"decapitated_guard"
display_name = "Guarda Decapitada"
required_core_level = 2
seal_definition = SubResource("AncientSeal")
seal_display_name = "Selo Antigo"
